# ── 虛擬環境（約 386MB，絕對不要進版控）────────────────────
.venv/
.venv312/
__pycache__/
*.py[cod]
*.egg-info/

# ── 原始素材 ────────────────────────────────────────────
# 音樂檔有版權且體積大（8 首約 60MB），歌詞屬未發表的私人作品
input/

# ── 成品 ────────────────────────────────────────────────
# 這是公開倉庫，個人歌曲的時間軸與歌詞不公開。
# 想自己留存版本，開一個 private repo，或用 git add -f 強制加入。
output/

# ── 模型快取 ────────────────────────────────────────────
.hfcache/
*.bin
*.onnx

# ── 雜項 ────────────────────────────────────────────────
.DS_Store
*.log
.tmp/
